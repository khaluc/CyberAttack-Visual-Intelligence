LLM_ENABLED="false"
LLM_PROVIDER="dashscope"
LLM_API_KEY=""
LLM_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="glm-5.2"
LLM_TEMPERATURE="0.1"
LLM_TIMEOUT="60"
# Empty uses the built-in PHASE 2 Cyber Security JSON prompt.
LLM_SYSTEM_PROMPT=""
RAG_ENABLED="true"
RAG_LOCALIZATION_ENABLED="true"
AZURE_OPENAI_API_VERSION="2024-10-21"
DASHSCOPE_API_KEY=""

# Local Flask launcher: python scripts/run_server.py
CVI_HOST="127.0.0.1"
CVI_PORT="5000"
CVI_DEBUG="false"

# PHASE 4 - MITRE ATT&CK RAG
MITRE_RAG_ENABLED="true"
MITRE_STIX_PATH="./data/mitre/enterprise-attack.json"
VECTOR_DB="chroma"
VECTOR_COLLECTION="mitre_enterprise_attack"
VECTOR_INDEX_PATH="./data/vector_db"
VECTOR_AUTO_REBUILD="true"
QDRANT_URL=""
QDRANT_API_KEY=""
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_REVISION=""
EMBEDDING_DEVICE=""
EMBEDDING_DIMENSION="0"
EMBEDDING_BATCH_SIZE="8"
EMBEDDING_MAX_SEQ_LENGTH="512"
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY=""
RAG_TOP_K="5"
PIPELINE_ORCHESTRATOR="langchain"

# Native renderer paths. Leave blank to use the bundled .tools discovery.
GRAPHVIZ_DOT=""
NODE_BINARY=""
MERMAID_CLI=""
PUPPETEER_EXECUTABLE_PATH=""

# Multi-source knowledge base
KNOWLEDGE_BASE_PATH="./data/knowledge_base"
KNOWLEDGE_DB_PATH="./data/knowledge_base/knowledge.sqlite3"
KB_SYNC_TIMEOUT="180"
KB_MAX_DOWNLOAD_MB="750"
# Optional comma-separated upstream overrides. Leave commented to use the
# maintained defaults in knowledge_base.py.
# KB_MITRE_ATTACK_URLS=""
# KB_SIGMA_URLS=""
# KB_YARA_URLS=""
# KB_THREAT_INTELLIGENCE_URLS=""
# KB_NIST_CIS_URLS=""
# KB_PLAYBOOKS_URLS=""

# Optional overrides; the service also auto-discovers Codex primary-runtime.
CVI_NODE_BINARY=""
ARTIFACT_TOOL_NODE_MODULES=""
